# POLYNOTES PRODUCTION ENV SETTINGS

# 1. Clerk Authentication Keys (Get these from your Clerk dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# 2. Database Connection (Get this from your Neon or Supabase dashboard)
# IMPORTANT: This must be a PostgreSQL connection string!
DATABASE_URL="postgres://user:password@hostname/dbname?sslmode=require"

# 3. Gemini Pipeline Configuration
GEMINI_API_KEY=AIzaSy...

# 4. Vercel Blob Storage (Storage tab of your Vercel project -> Create Blob store)
# Auto-populated when you link a Blob store to this project on Vercel.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
